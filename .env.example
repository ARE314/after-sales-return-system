# 售后返件登记系统 —— 容器部署环境变量样例
#
# 用法：
#     cp .env.example .env      # 然后**必须**改掉下面两项
#     docker compose up -d
#
# .env 已被 .dockerignore 与 .gitignore 排除，不会被打进镜像或提交。
#
# 安全提醒：`.env` 里是明文密码。文件权限设成 600（`chmod 600 .env`），
# 并且不要把它放在会被备份到公共位置的地方。

# ---------------------------------------------------------------------------
# 必填：首个管理员的初始密码
# ---------------------------------------------------------------------------
# 只在 auth_db 的 users 表为空（首次启动）时生效。
# 登录后系统会**强制改密**：未改密前服务端只放行「查身份 / 改密码 / 退出」
# 三个接口，其余一律 403 —— 所以这个初值即使泄露，也进不去业务功能，
# 但仍应在首次部署时就用一个强密码。
ARS_BOOTSTRAP_PASSWORD=ChangeMe_Before_First_Run

# 管理员账号名（一般不用改）
ARS_BOOTSTRAP_USER=admin

# ---------------------------------------------------------------------------
# 对外地址与 Cookie 安全
# ---------------------------------------------------------------------------
# 走反向代理对外时的公网地址，用于页面里生成绝对链接
ARS_PUBLIC_BASE_URL=https://returns.example.com

# **HTTPS 部署必须同时把这两个设为 1**：
#   COOKIE_SECURE=1  会话 Cookie 加 Secure 标记（否则明文传输）
#   HTTPS_ONLY=1     拒绝明文 HTTP 登录
ARS_COOKIE_SECURE=0
ARS_HTTPS_ONLY=0

# 反向代理地址。**只有配了它才会信任 X-Forwarded-For / Proto** ——
# 不配就只取传输层对端地址（防伪造请求头绕过 IP 白名单）。
# 反代与容器同机时通常是宿主地址或 Docker 网桥网关。
ARS_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# 数据接口（金山文档定时任务拉取用）
# ---------------------------------------------------------------------------
# 允许调用的来源 IP / 网段，逗号分隔。**留空 = 不限制**（仅建议内网时留空）。
# 例：ARS_OPEN_API_IPS=203.0.113.10,203.0.113.0/24
ARS_OPEN_API_IPS=

# ---------------------------------------------------------------------------
# 数据库（MySQL 8）—— 2026-09-22 起数据本体在 MySQL 里，不再是 data/ 下的 .db 文件
# ---------------------------------------------------------------------------
# 六个库是 **schema**（returns_db / inspect_db / handle_db / items_db /
# auth_db / delivery_db），一个连接 ATTACH 全部。
#
# 用 compose 里的 mysql 服务时，主机名填服务名 mysql；用外部 MySQL 时填它的地址。
# **口令必须与 mysql 服务（或外部库）里 ars 账号的口令一致**，
# 否则主服务连不上库、启动即失败。
ARS_MYSQL_HOST=mysql
ARS_MYSQL_PORT=3306
ARS_MYSQL_USER=ars
ARS_MYSQL_PASSWORD=ChangeMe_MysqlPassword

# 建库与建账号的初始化脚本挂在 compose 的 mysql 服务上（deploy/mysql-init.sh）。
# **它只在数据卷为空（首次启动）时执行**；改了账号口令要么改 .env 后重建数据卷，
# 要么进容器手工 ALTER USER。

# ---------------------------------------------------------------------------
# 备份
# ---------------------------------------------------------------------------
# 保留份数（当前每个全量约 35 MB —— mysqldump 的文本比 SQLite 库文件大得多；
# 照片多了要重估磁盘占用）
ARS_BACKUP_KEEP=14
