# 售后返件登记系统 —— 定时备份（一次性任务，由 ars-backup.timer 触发）
#
# 也可手工执行：sudo systemctl start ars-backup.service
# 直接跑脚本：  sudo -u ars /opt/ars/.venv/bin/python /opt/ars/tools/backup.py
#
# 注释字符必须是 `#`（systemd 只认它）。

[Unit]
Description=售后返件登记系统 —— 数据备份（五库 + 照片，一致性快照）
Documentation=file:/opt/ars/deploy/README.md
# 与主服务没有强依赖：备份走只读的 VACUUM INTO，服务在跑也能做。
# 但让它在服务之后启动，避免开机时两者抢磁盘。
After=ars.service

[Service]
Type=oneshot
User=ars
Group=ars
WorkingDirectory=/opt/ars

Environment=PYTHONUNBUFFERED=1
# 保留份数（当前全量约 1.3 MB/份，14 份占用很小；照片多了要重估）
# 由 backup.py 自己读这个环境变量 —— systemd 的 ExecStart **不做变量展开**，
# 所以配置项一律走 Environment，别在 ExecStart 里写 ${...}。
Environment=ARS_BACKUP_KEEP=14
# 备份落到哪里。留空 = <项目>/data/backups/。要异地（NAS / 另一块盘）就填绝对路径，
# 并把该路径加进下面的 ReadWritePaths，否则会被沙箱挡住。
# 例：Environment=ARS_BACKUP_OUT=/mnt/nas/ars-backups
Environment=ARS_BACKUP_OUT=

ExecStart=/opt/ars/.venv/bin/python /opt/ars/tools/backup.py

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ars-backup

# ---------- 安全加固 ----------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# 备份写在 data/ 下，所以只需放开 data/
ReadWritePaths=/opt/ars/data
